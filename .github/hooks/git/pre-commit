#!/usr/bin/env python3
"""Pre-commit hook: check for hardcoded language knowledge in linter/."""
import re, subprocess, sys
from pathlib import Path

hook_dir = Path(__file__).resolve().parent
root = hook_dir.parents[1]
lint_dir = root / "lint"

if not lint_dir.exists():
    sys.exit(0)

issues = []

for f in sorted(lint_dir.rglob("*.py")):
    text = f.read_text(encoding="utf-8")
    for i, line in enumerate(text.splitlines(), 1):
        # 任何 keyword.end* 的硬编码（不限具体关键字）
        if re.search(r'keyword\.end\w+', line):
            issues.append((f.relative_to(root), i, f"hardcoded keyword.end* token: {line.strip()}"))

        # 任何 space.* / newline.* token 类型的硬编码
        if re.search(r'"(?:space|newline)\.[\w.]+"', line):
            issues.append((f.relative_to(root), i, f"hardcoded trivia token: {line.strip()}"))

        # 中文字符（注释除外）
        if re.search(r'[\u4e00-\u9fff]', line) and not line.strip().startswith("#"):
            issues.append((f.relative_to(root), i, f"Chinese character in code: {line.strip()}"))

if issues:
    print("[hardcode-check] ❌ 发现硬编码语言知识，请修复：")
    for path, lineno, msg in issues:
        print(f"  {path}:{lineno}  {msg}")
    sys.exit(1)
