#!/bin/sh
# Git commit-msg hook — validate message format: type(scope): description
# Types: feat|fix|refactor|style|test|docs|chore|perf|ci

MSG_FILE="$1"

# Skip merge commits
if echo "$MSG" | grep -q "^Merge "; then
    exit 0
fi

MSG=$(cat "$MSG_FILE")

if echo "$MSG" | grep -qE '^(feat|fix|refactor|style|test|docs|chore|perf|ci)(\([^)]+\))?:\s.+'; then
    FIRST_LINE=$(echo "$MSG" | head -1)
    LEN=${#FIRST_LINE}
    if [ "$LEN" -gt 72 ]; then
        echo ""
        echo "  Error: first line exceeds 72 characters ($LEN)."
        echo ""
        exit 1
    fi
    exit 0
else
    echo ""
    echo "  Invalid commit message format."
    echo ""
    echo "  Expected: type(scope): description"
    echo "  Example:  feat(parser): add for-loop support"
    echo ""
    echo "  Types: feat, fix, refactor, style, test, docs, chore, perf, ci"
    echo ""
    exit 1
fi
