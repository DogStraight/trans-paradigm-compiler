{
  "desc": "linter 错误发现准确度对照表。expect 列出该样本应被检出的诊断 code（命中任一即类别正确检出）；错误样本 expect 非空，合法样本 expect 为空（不应报错）。",
  "samples": {
    "ref_e01_missing_endmodule.v":   { "desc": "缺 endmodule",                    "expect": ["phase1-boundary"] },
    "ref_e02_extra_endmodule.v":     { "desc": "多余 endmodule",                  "expect": ["phase1-boundary"] },
    "ref_e03_unclosed_begin.v":      { "desc": "begin 未闭合（缺 end）",          "expect": ["phase1-boundary"] },
    "ref_e04_stray_end.v":           { "desc": "孤立 end 无 begin",               "expect": ["phase1-boundary"] },
    "ref_e05_missing_semicolon.v":   { "desc": "缺分号",                          "expect": ["phase-statement"] },
    "ref_e06_missing_module_name.v": { "desc": "模块缺名",                        "expect": ["phase-statement"] },
    "ref_e07_bad_keyword.v":         { "desc": "关键字拼错 alwayss",              "expect": ["phase-unrecognized"] },
    "ref_e08_assign_no_rhs.v":       { "desc": "赋值缺 RHS",                      "expect": ["phase-expr"] },
    "ref_e09_if_missing_paren.v":    { "desc": "if 缺括号",                       "expect": ["phase-unrecognized"] },
    "ref_e10_expr_bad_rhs.v":        { "desc": "表达式尾随运算符",                "expect": ["phase-expr"] },
    "ref_e11_expr_unclosed_paren.v": { "desc": "表达式括号未闭合",                "expect": ["phase-expr"] },
    "ref_e12_undefined_macro.v":     { "desc": "行内未定义宏调用",               "expect": ["undefined-macro"] },
    "ref_e13_missing_wire_name.v":   { "desc": "wire 缺名",                       "expect": ["phase-statement"] },
    "ref_e14_truncated_assign.v":    { "desc": "assign 被截断（无分号/无结束）",   "expect": ["phase-statement", "phase1-boundary"] },
    "ref_e15_bad_always_body.v":     { "desc": "always 缺语句体（endmodule 紧跟 @(*)）", "expect": ["phase-statement"] },
    "ref_e16_mismatched_brace.v":    { "desc": "花括号未闭合",                    "expect": ["phase-expr"] },
    "ref_e17_if_missing_rparen.v":   { "desc": "if 缺右括号",                     "expect": ["phase-unrecognized"] },
    "ref_e18_for_missing_semicolon.v": { "desc": "for 缺分号",                   "expect": ["phase-statement"] },
    "ref_e19_case_missing_endcase.v": { "desc": "case 误用 end 作结束符",         "expect": ["phase-statement", "phase1-boundary"] },
    "ref_e20_task_missing_endtask.v": { "desc": "task 误用 end 作结束符",         "expect": ["phase1-boundary"] },
    "ref_e21_expr_double_op.v":      { "desc": "表达式双运算符 b + * c",          "expect": ["phase-expr", "phase-statement"] },
    "ref_e22_assign_no_lhs.v":       { "desc": "assign 缺左值",                   "expect": ["phase-expr", "phase-statement"] },
    "ref_e23_assign_missing_eq.v":   { "desc": "assign 缺等号 a b",               "expect": ["phase-statement", "phase-expr"] },
    "ref_e24_assign_extra_rhs.v":    { "desc": "RHS 多余（链式 = b = c）",         "expect": ["phase-statement"] },
    "ref_e25_for_missing_rparen.v":  { "desc": "for 缺右括号",                    "expect": ["phase1-boundary", "phase-statement"] },
    "ref_e26_case_missing_colon.v":  { "desc": "case item 缺冒号",                "expect": ["phase-statement"] },
    "ref_e27_assign_rhs_adjacent.v": { "desc": "RHS 相邻操作数缺运算符 b c",       "expect": ["phase-statement"] },
    "ref_e28_for_missing_first_semi.v": { "desc": "for 缺第一个分号",             "expect": ["phase-unrecognized"] },
    "ref_e29_while_missing_rparen.v":  { "desc": "while 缺右括号",               "expect": ["phase-statement", "phase1-boundary"] },
    "ref_e30_ifgen_missing_semi.v":    { "desc": "模块项 if-generate 体内缺分号", "expect": ["phase-statement"] },
    "ref_e31_casegen_missing_endcase.v": { "desc": "模块项 case-generate 缺 endcase", "expect": ["phase-statement", "phase1-boundary"] },
    "ref_e32_nettype_unrestored.v": { "desc": "nettype 指令设 none 后未复位（MH001）", "expect": ["MH001"] },
    "ref_e33_macro_redef.v":       { "desc": "宏以不同值重定义未先 undef（MH002）", "expect": ["MH002"] }
  },
  "valid": {
    "ref_v01_wire_assign.v":    { "desc": "合法：wire+assign" },
    "ref_v02_always_posedge.v": { "desc": "合法：always+if/else" },
    "ref_v03_initial.v":        { "desc": "合法：initial" },
    "ref_v04_vector_select.v":  { "desc": "合法：位选 data[0]" },
    "ref_v05_module_inst.v":    { "desc": "合法：模块实例化" },
    "ref_v06_nettype_restored.v": { "desc": "合法：nettype 指令已复位 wire（不报 MH001）" },
    "ref_v07_macro_redef_same.v": { "desc": "合法：宏同值重定义（不报 MH002，对齐 Verilator REDEFMACRO）" }
  }
}
