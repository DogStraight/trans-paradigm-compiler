pyv_compiler
├── 词法分析模块
│   ├── Token定义
│   ├── 词法分析器(PyvLexer)
│   └── 词法单元生成
├── 语法解析模块
│   ├── 语法规则定义
│   ├── 语法解析器(PyvParser)
│   ├── 语法树构建
├── 语法检查模块
│   ├── GrammarRuleChecker
│   │   ├── 语法规则匹配
│   │   ├── 特殊语法检查
│   │   └── 长度计算
│   └── 表达式类型检查
├── 代码生成模块
│   ├── 代码生成器(PyvCodeGenerator)
│   ├── 代码生成器模板
└── 工具模块
    ├── pyv_utils
    │   ├── 规则加载
    │   └── 工具函数
    └── 基础定义
        ├── Token
        ├── Node
        └── GrammarRule